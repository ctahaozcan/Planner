<Window x:Class="Planner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Planner.App.ViewModels"
        xmlns:views="clr-namespace:Planner.App.Views"
        Title="Yaver"
        Icon="Assets/app.ico"
        Height="840" Width="1280"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDetailedCommand}"/>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding FocusQuickAddCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenSearchCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CloseSearchCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,20">
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding FocusText}"
                            Command="{Binding ToggleFocusCommand}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FocusPhaseText}" Style="{StaticResource MutedText}" FontSize="12"
                               Visibility="{Binding FocusRunning, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Mola başlat" HorizontalAlignment="Left"
                            Command="{Binding StartBreakCommand}" Margin="0,6,0,10"
                            Visibility="{Binding FocusRunning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Pencereyi kapatınca tepside kalır." Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Margin="0,6,0,0" Text="Çıkış: tepsi simgesi → Çıkış" Style="{StaticResource MutedText}" FontSize="12"/>
                </StackPanel>
                <StackPanel Margin="16,22,16,0">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,24">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource LogoBgBrush}">
                            <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Yaver" FontWeight="SemiBold" FontSize="18"/>
                            <TextBlock Text="Günlük asistan" Style="{StaticResource MutedText}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTodayPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoTodayCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8BF;" FontSize="16" Width="24"/>
                                <TextBlock Text="Bugün"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAgendaPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoAgendaCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE787;" FontSize="16" Width="24"/>
                                <TextBlock Text="Ajanda"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWeekPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoWeekCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="16" Width="24"/>
                                <TextBlock Text="Hafta"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTasksPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoTasksCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE9D5;" FontSize="16" Width="24"/>
                                <TextBlock Text="Görevler"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHabitsPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoHabitsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8C7;" FontSize="16" Width="24"/>
                                <TextBlock Text="Alışkanlıklar"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLeavesPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoLeavesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7C5;" FontSize="16" Width="24"/>
                                <TextBlock Text="İzinler"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsContactsPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoContactsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE716;" FontSize="16" Width="24"/>
                                <TextBlock Text="Kişiler"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border CornerRadius="10" Margin="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource NavButton}" Command="{Binding GoSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" Width="24"/>
                                <TextBlock Text="Ayarlar"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Ara"
                        Command="{Binding OpenSearchCommand}" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Ayrıntılı kayıt"
                        Command="{Binding NewDetailedCommand}"
                        Visibility="{Binding ShowQuickAdd, Converter={StaticResource BoolToVis}}"/>
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="10" Padding="12"
                    Background="{DynamicResource AccentSoftBrush}"
                    Visibility="{Binding ShowBriefingBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Kapat"
                            Command="{Binding DismissBriefingCommand}"/>
                    <StackPanel>
                        <TextBlock Text="Günaydın özeti" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding Briefing.Summary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="2">
                <Border Margin="0,16,0,0" CornerRadius="10"
                        Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                        Visibility="{Binding ShowQuickAdd, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBox x:Name="QuickAddBox" Height="44" FontSize="15" Background="Transparent" BorderThickness="0"
                                 Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding QuickAddCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{DynamicResource TextSubtleBrush}"
                                   Text="Hızlı ekle — örn. yarın 14:00 dişçi  (Ctrl+N ayrıntılı, Ctrl+F ara)"
                                   Visibility="{Binding QuickAddText, Converter={StaticResource EmptyToVis}}"/>
                    </Grid>
                </Border>
                <Border Margin="0,8,0,8" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left"
                        Background="{DynamicResource ChipBgBrush}"
                        Visibility="{Binding QuickAddPreview, Converter={StaticResource EmptyToVisInv}}">
                    <TextBlock Text="{Binding QuickAddPreview}" FontSize="12" Style="{StaticResource MutedText}"/>
                </Border>
            </StackPanel>
            <ContentControl Grid.Row="3" Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:TodayViewModel}">
                        <views:TodayView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:AgendaViewModel}">
                        <views:AgendaView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:WeekViewModel}">
                        <views:WeekView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                        <views:TasksView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HabitsViewModel}">
                        <views:HabitsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LeavesViewModel}">
                        <views:LeavesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ContactsViewModel}">
                        <views:ContactsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding SearchOpen, Converter={StaticResource BoolToVis}}"
                MouseDown="OnSearchOverlayMouseDown">
            <Border Style="{StaticResource Card}" Width="560" MaxHeight="480" VerticalAlignment="Top" Margin="0,80,0,0"
                    HorizontalAlignment="Center">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent"
                             Margin="0,10,0,0" MouseDoubleClick="OnSearchResultActivate">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
