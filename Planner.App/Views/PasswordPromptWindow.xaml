<Window x:Class="Planner.App.Views.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <PasswordBox x:Name="PasswordBox" Height="40"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Tamam" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
