<Window x:Class="Planner.App.Views.TextDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="860" Width="1100"
        MinHeight="560" MinWidth="800"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}">
    <Window.Resources>
        <Style x:Key="DocTool" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DocCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="16,12,16,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Content="Word" Command="{Binding ExportWordCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="PDF" Command="{Binding ExportPdfCommand}"/>
            </StackPanel>
            <StackPanel>
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold"
                         Background="Transparent" BorderThickness="0" Padding="0,2"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12" Margin="2,2,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,1" Padding="12,8">
            <WrapPanel>
                <Button Style="{StaticResource DocTool}" Content="↶" ToolTip="Geri al" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="↷" ToolTip="Yinele" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=Editor}"/>
                <ComboBox x:Name="StyleBox" Style="{StaticResource DocCombo}" Width="120" SelectedIndex="0" SelectionChanged="OnStyleChanged">
                    <ComboBoxItem Content="Normal"/>
                    <ComboBoxItem Content="Başlık"/>
                    <ComboBoxItem Content="Başlık 1"/>
                    <ComboBoxItem Content="Başlık 2"/>
                </ComboBox>
                <ComboBox x:Name="FontBox" Style="{StaticResource DocCombo}" Width="150" SelectionChanged="OnFontChanged">
                    <ComboBoxItem Content="Calibri" IsSelected="True"/>
                    <ComboBoxItem Content="Cambria"/>
                    <ComboBoxItem Content="Arial"/>
                    <ComboBoxItem Content="Georgia"/>
                    <ComboBoxItem Content="Times New Roman"/>
                    <ComboBoxItem Content="Segoe UI"/>
                    <ComboBoxItem Content="Verdana"/>
                    <ComboBoxItem Content="Consolas"/>
                </ComboBox>
                <ComboBox x:Name="SizeBox" Style="{StaticResource DocCombo}" Width="64" SelectionChanged="OnSizeChanged">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12" IsSelected="True"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="28"/>
                    <ComboBoxItem Content="36"/>
                </ComboBox>
                <Button Style="{StaticResource DocTool}" Content="B" FontWeight="Bold" ToolTip="Kalın"
                        Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="I" FontStyle="Italic" ToolTip="İtalik"
                        Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="U" ToolTip="Altı çizili"
                        Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="S" ToolTip="Üstü çizili" Click="OnStrike"/>
                <Button Style="{StaticResource DocTool}" Content="A" Foreground="#DC2626" ToolTip="Metin rengi" Click="OnTextColor"/>
                <Button Style="{StaticResource DocTool}" Content="▮" ToolTip="Vurgu rengi" Click="OnHighlight"/>
                <Button Style="{StaticResource DocTool}" Content="⬅" ToolTip="Sola"
                        Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="↔" ToolTip="Ortala"
                        Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="➡" ToolTip="Sağa"
                        Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="☰" ToolTip="Yasla"
                        Command="EditingCommands.AlignJustify" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="•" ToolTip="Madde"
                        Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="1." ToolTip="Numara"
                        Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="⇥" ToolTip="Girinti artır"
                        Command="EditingCommands.IncreaseIndentation" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="⇤" ToolTip="Girinti azalt"
                        Command="EditingCommands.DecreaseIndentation" CommandTarget="{Binding ElementName=Editor}"/>
                <Button Style="{StaticResource DocTool}" Content="🖼" ToolTip="Görsel ekle" Click="OnInsertImage"/>
                <Button Style="{StaticResource DocTool}" Content="▦" ToolTip="Tablo ekle" Click="OnInsertTable"/>
            </WrapPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Background="{DynamicResource AppBgBrush}">
            <Border Width="816" MinHeight="1056" Margin="24,20,24,40" Padding="96,72"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent"
                             AcceptsTab="True" CaretBrush="{DynamicResource TextBrush}"
                             FontFamily="Calibri, Segoe UI, sans-serif" FontSize="12"
                             HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                             TextChanged="OnEditorChanged"/>
            </Border>
        </ScrollViewer>
        <DockPanel Grid.Row="3" Margin="16,6,16,10">
            <TextBlock DockPanel.Dock="Right" Text="Sayfa · A4" Style="{StaticResource MutedText}" FontSize="11"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
