<UserControl x:Class="Planner.App.Views.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Planner.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="◀" Command="{Binding PreviousWeekCommand}" Width="40" Margin="0,0,6,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Bu hafta" Command="{Binding ThisWeekCommand}" Margin="0,0,6,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="▶" Command="{Binding NextWeekCommand}" Width="40"/>
            </StackPanel>
            <TextBlock Text="{Binding RangeLabel}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="4" MinWidth="150" VerticalAlignment="Stretch">
                            <DockPanel>
                                <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Command="{Binding DataContext.OpenDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Leaves}" Margin="0,4,0,0"
                                              Visibility="{Binding HasLeaves, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,4" CornerRadius="6" Padding="6,4"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <views:TaskCard/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
