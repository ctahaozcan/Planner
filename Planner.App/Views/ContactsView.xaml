<UserControl x:Class="Planner.App.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Kişiler kasasını oluşturun" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                               Text="Telefonunuzu kaybetseniz bile önemli kişilerin adı, telefonu ve adresine buradan ulaşabilirsiniz. Kayıtlar diskte AES-256 ile şifrelenir. Şifre saklanmaz; unutursanız kişileri kurtarmanın bir yolu yoktur."/>
                    <TextBlock Margin="0,16,0,6" Text="Şifre (en az 8 karakter)"/>
                    <PasswordBox x:Name="SetupPassword" Height="40"/>
                    <TextBlock Margin="0,12,0,6" Text="Şifre tekrar"/>
                    <PasswordBox x:Name="SetupConfirm" Height="40"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToVisInv}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Kasayı oluştur" Margin="0,16,0,0"
                            Click="OnSetup" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="480" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Kişiler kilitli" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                               Text="Kişileri görmek, eklemek veya silmek için kasa şifresini girin."/>
                    <TextBlock Margin="0,16,0,6" Text="Şifre"/>
                    <PasswordBox x:Name="UnlockPassword" Height="40" KeyDown="OnUnlockKeyDown"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToVisInv}}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Kilidi aç" Margin="0,16,0,0" Click="OnUnlock"/>
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Şifreyi unuttuysanız Ayarlar → Kasayı sıfırla. Bu işlem tüm kişileri siler."/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Kilitle" Command="{Binding LockCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Sil" Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Düzenle" Command="{Binding EditCommand}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Kişi ekle" Command="{Binding AddCommand}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>
                <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="{Binding Relationship}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                               Visibility="{Binding Relationship, Converter={StaticResource EmptyToVisInv}}"/>
                                    <TextBlock Text="{Binding Phone}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Kişi kartı" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}"
                                   Visibility="{Binding SelectedContact, Converter={StaticResource EmptyToVis}}"
                                   Text="Soldan bir kişi seçin veya yeni kişi ekleyin."/>
                        <StackPanel Visibility="{Binding SelectedContact, Converter={StaticResource EmptyToVisInv}}">
                            <TextBlock Text="{Binding SelectedContact.Name}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="İlişki"/>
                            <TextBlock Text="{Binding SelectedContact.Relationship}"/>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="Telefon"/>
                            <TextBlock Text="{Binding SelectedContact.Phone}"/>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="E-posta"/>
                            <TextBlock Text="{Binding SelectedContact.Email}"/>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="Adres"/>
                            <TextBlock Text="{Binding SelectedContact.Address}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="Notlar"/>
                            <TextBlock Text="{Binding SelectedContact.Notes}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource MutedText}" Text="Takip tarihi"/>
                            <DatePicker SelectedDate="{Binding FollowUpDate}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Takip et" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Command="{Binding FollowUpCommand}"/>
                        </StackPanel>
                        <TextBlock Margin="0,16,0,0" Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
