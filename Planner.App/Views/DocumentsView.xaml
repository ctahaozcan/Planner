<UserControl x:Class="Planner.App.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="NewButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Content="+ Yeni" Click="OnNewClick" MinWidth="110">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Belge" Click="OnNewText"/>
                        <MenuItem Header="E-tablo" Click="OnNewTable"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Sil"
                    Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Aç"
                    Command="{Binding OpenCommand}" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Paylaş"
                    Command="{Binding ShareCommand}" Margin="0,0,8,0"/>
            <TextBox Width="220" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Dosya adında ara"/>
            <TextBlock DockPanel.Dock="Right" Text="Ara" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Belge ve e-tablo. Çift tıkla veya Aç. Sil her zaman görünür."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </DockPanel>
        <ScrollViewer x:Name="DocScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" SizeChanged="OnScrollSizeChanged">
            <Grid>
                <ListBox x:Name="DocList" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnListDoubleClick"
                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInv}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="DocWrap"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,16,16"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="196" Style="{StaticResource Card}" Padding="0" Cursor="Hand"
                                    MouseLeftButtonUp="OnCardClick">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="100"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border CornerRadius="12,12,0,0" Padding="16"
                                            Background="{Binding Tint, Converter={StaticResource HexToBrush}}">
                                        <Grid>
                                            <Border Width="48" Height="62" Background="#F8FAFC" CornerRadius="4"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IconGlyph}" FontSize="26" FontWeight="Bold"
                                                           Foreground="{Binding Tint, Converter={StaticResource HexToBrush}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding KindLabel}" Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="12,10,12,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" FontSize="12"/>
                                        <TextBlock Text="{Binding ShareHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <UniformGrid Grid.Row="2" Columns="3" Margin="8,0,8,10">
                                        <Button Style="{StaticResource ChipButton}" Content="Aç" Margin="2"
                                                Click="OnOpenCard" Tag="{Binding}"/>
                                        <Button Style="{StaticResource ChipButton}" Content="Paylaş" Margin="2"
                                                Click="OnShareCard" Tag="{Binding}"/>
                                        <Button Style="{StaticResource ChipButton}" Content="Sil" Margin="2"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Click="OnDeleteCard" Tag="{Binding}"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                    <TextBlock Text="Drive’daki gibi bir dosya oluşturun" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,18"
                               Text="Belge kelime işlemcidir. E-tablo formül ve sayfa içerir. Arkadaşlarınızla paylaşabilirsiniz."/>
                    <WrapPanel>
                        <Button Width="220" Height="160" Margin="0,0,16,16" Click="OnNewText" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="52" Height="64" CornerRadius="4" Background="#1A73E8" Margin="0,0,0,10">
                                                <TextBlock Text="¶" Foreground="White" FontSize="28" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Belge" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#1A73E8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="220" Height="160" Click="OnNewTable" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="52" Height="64" CornerRadius="4" Background="#188038" Margin="0,0,0,10">
                                                <TextBlock Text="▦" Foreground="White" FontSize="26" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="E-tablo" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#188038"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </StackPanel>
                <TextBlock Text="Aramayla eşleşen dosya yok." Style="{StaticResource MutedText}"
                           Visibility="{Binding NoSearchHits, Converter={StaticResource BoolToVis}}" Margin="4,8,0,0"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
