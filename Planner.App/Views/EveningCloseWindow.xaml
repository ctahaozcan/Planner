<Window x:Class="Planner.App.Views.EveningCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akşam kapanışı" Height="480" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Akşam kapanışı" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,12" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="Bitirdiklerinizi gözden geçirin. Açık kalanları yarına taşıyabilir, kısa bir not yazabilirsiniz."/>
        </StackPanel>
        <ListBox x:Name="OpenList" Grid.Row="1" DisplayMemberPath="Title"/>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Günün notu" Margin="0,0,0,6"/>
            <TextBox x:Name="NoteBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
        </DockPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Kalanları yarına taşı" Click="OnMove" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Kapat" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
