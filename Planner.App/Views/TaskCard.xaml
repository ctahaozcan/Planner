<UserControl x:Class="Planner.App.Views.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="3" Margin="0,2,12,2"
                    Background="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"/>
            <StackPanel Grid.Column="1">
                <DockPanel>
                    <TextBlock Text="{Binding TimeText}" DockPanel.Dock="Right"
                               Style="{StaticResource MutedText}" FontWeight="SemiBold"
                               Visibility="{Binding TimeText, Converter={StaticResource EmptyToVisInv}}"/>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border CornerRadius="8" Padding="8,3" Margin="0,0,8,0"
                            Background="{DynamicResource ChipBgBrush}">
                        <TextBlock FontSize="12" Foreground="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"
                                   Text="{Binding CategoryName}" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="8" Padding="8,3" Margin="0,0,8,0" Background="{DynamicResource ChipBgBrush}"
                            Visibility="{Binding HasReminder, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" Text="Anımsatıcı" Style="{StaticResource MutedText}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="8,3" Margin="0,0,8,0" Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" Text="{Binding RecurrenceText}" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="8,3" Margin="0,0,8,0" Background="{DynamicResource PriorityBandBrush}"
                            Visibility="{Binding IsPriority, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" Text="Öncelik" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding Notes}" Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Visibility="{Binding Notes, Converter={StaticResource EmptyToVisInv}}"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Başlamadı" Command="{Binding MarkNotStartedCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNotStarted}" Value="True">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Devam Ediyor" Command="{Binding MarkInProgressCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                        <Setter Property="Background" Value="#DBEAFE"/>
                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Duraklatıldı" Command="{Binding MarkPausedCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                        <Setter Property="Foreground" Value="#B45309"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Tamamlandı" Command="{Binding MarkDoneCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Background" Value="#D1FAE5"/>
                                        <Setter Property="Foreground" Value="#047857"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Öncelik" Command="{Binding PinCommand}" Style="{StaticResource ChipButton}"
                            Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Atla" Command="{Binding SkipCommand}" Style="{StaticResource ChipButton}"
                            Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="10 dk" Command="{Binding Snooze10Command}" Style="{StaticResource ChipButton}"
                            Visibility="{Binding CanSnooze, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="1 saat" Command="{Binding SnoozeHourCommand}" Style="{StaticResource ChipButton}"
                            Visibility="{Binding CanSnooze, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Bu akşam" Command="{Binding SnoozeEveningCommand}" Style="{StaticResource ChipButton}"
                            Visibility="{Binding CanSnooze, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Yarına" Command="{Binding SnoozeTomorrowCommand}" Style="{StaticResource ChipButton}"
                            Visibility="{Binding CanSnooze, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Düzenle" Command="{Binding EditCommand}" Padding="10,6" Margin="0,0,0,6"/>
                <Button Style="{StaticResource DangerButton}" Content="Sil" Command="{Binding DeleteCommand}" Padding="10,6"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
