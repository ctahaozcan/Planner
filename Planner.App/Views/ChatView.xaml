<UserControl x:Class="Planner.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,8,12,8">
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding ConnectionHint}"/>
                    <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="Kullanıcı adı ile ekle"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Ara"
                                Command="{Binding SearchUsersCommand}" Margin="8,0,0,0" Padding="12,6"/>
                        <Grid>
                            <TextBox Text="{Binding UserQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchUsersCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       Text="kullanıcı adı yazın"
                                       Visibility="{Binding UserQuery, Converter={StaticResource EmptyToVis}}"/>
                        </Grid>
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding SearchStatus}"/>
                    <ItemsControl Margin="0,8,0,8" ItemsSource="{Binding SearchHits}"
                                  Visibility="{Binding HasSearchHits, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}"
                                                Content="{Binding ActionLabel}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RequestByHitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanRequest}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,4,0,8" Visibility="{Binding HasPendingRequests, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontWeight="SemiBold" Margin="0,4,0,6" Text="Gelen istekler"/>
                        <ItemsControl ItemsSource="{Binding PendingRequests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PrimaryButton}" Content="Kabul"
                                                        Command="{Binding DataContext.AcceptPendingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="10,4"/>
                                                <Button Style="{StaticResource ChipButton}" Content="Reddet" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DeclinePendingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="10,4"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock FontWeight="SemiBold" Margin="0,4,0,6" Text="Sohbetler"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPeer}"
                         BorderThickness="0" Background="Transparent" Margin="8,0,8,12"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="#22C55E"
                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding ListSub}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Style="{StaticResource ChipButton}" Content="Arkadaş ekle" Margin="0,0,6,4"
                            Command="{Binding AddFriendCommand}" IsEnabled="{Binding HasPeer}"/>
                    <Button Content="İş" Margin="0,0,6,4"
                            Command="{Binding SetPeerWorkCommand}" IsEnabled="{Binding IsFriend}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPeerWork}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Özel" Margin="0,0,6,4"
                            Command="{Binding SetPeerPersonalCommand}" IsEnabled="{Binding IsFriend}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPeerPersonal}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource ChipButton}" Content="Ajanda" Margin="0,0,6,4"
                            Command="{Binding ViewAgendaCommand}" IsEnabled="{Binding IsFriend}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Görev ata" Margin="0,0,6,4"
                            Command="{Binding AssignTaskCommand}" IsEnabled="{Binding IsFriend}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Ara" Margin="0,0,6,4"
                            Command="{Binding CallAudioCommand}" IsEnabled="{Binding IsFriend}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Görüntülü" Margin="0,0,6,4"
                            Command="{Binding CallVideoCommand}" IsEnabled="{Binding IsFriend}"/>
                </WrapPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PeerClassLabel}" Style="{StaticResource MutedText}" FontSize="12"
                               Visibility="{Binding IsFriend, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEmptyThread, Converter={StaticResource BoolToVisInv}}">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                        <Border MaxWidth="440" Padding="10,8" CornerRadius="12"
                                                HorizontalAlignment="{Binding Align}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock FontSize="11" Style="{StaticResource MutedText}">
                                                    <Run Text="{Binding FromName, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding TimeText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Image Source="{Binding Picture}" MaxWidth="280" Margin="0,6,0,0"
                                                       Stretch="Uniform"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                                                <Button Style="{StaticResource ChipButton}" Margin="0,6,0,0"
                                                        HorizontalAlignment="Left"
                                                        Content="{Binding FileName}"
                                                        Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.OpenChatFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           FontFamily="Segoe UI Emoji, Segoe UI"
                                                           Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                            Visibility="{Binding CanReact, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="{Binding ThumbLabel}"
                                                            Command="{Binding DataContext.ToggleThumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,4">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IThumbed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Style="{StaticResource ChipButton}" Content="Düzenle" Margin="6,0,0,0"
                                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,4"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                            Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVis}}">
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Kabul et"
                                                            Command="{Binding DataContext.AcceptFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="Reddet" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.DeclineFriendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                               Visibility="{Binding IsEmptyThread, Converter={StaticResource BoolToVis}}"
                               Text="Soldan bir kişi seçin veya kullanıcı adı ile arayıp arkadaşlık isteği gönderin. Arkadaş olmayana mesaj gitmez."/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{Binding SendLabel}"
                        Command="{Binding SendCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanMessage}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Vazgeç"
                        Command="{Binding CancelEditCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Dosya"
                        Command="{Binding SendFileCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanMessage}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Resim"
                        Command="{Binding SendImageCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanMessage}"/>
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button x:Name="EmojiButton" Style="{StaticResource SecondaryButton}" Content="😊"
                            Command="{Binding ToggleEmojiCommand}"
                            IsEnabled="{Binding CanMessage}"/>
                    <Popup IsOpen="{Binding EmojiOpen, Mode=TwoWay}" Placement="Top" StaysOpen="False"
                           AllowsTransparency="True" PlacementTarget="{Binding ElementName=EmojiButton}">
                        <Border Style="{StaticResource Card}" Padding="8" MaxWidth="320">
                            <ItemsControl ItemsSource="{Binding Emojis}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" FontSize="18" FontFamily="Segoe UI Emoji, Segoe UI"
                                                Margin="2" Padding="4" Style="{StaticResource ChipButton}"
                                                Command="{Binding DataContext.InsertEmojiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
                <Border CornerRadius="10" Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <TextBox Height="44" FontSize="15" Background="Transparent" BorderThickness="0"
                             FontFamily="Segoe UI Emoji, Segoe UI"
                             IsEnabled="{Binding CanMessage}"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
