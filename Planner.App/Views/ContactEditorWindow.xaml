<Window x:Class="Planner.App.Views.ContactEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="680" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <TextBlock Text="Ad soyad" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="İlişki (aile, iş, acil…)" Margin="0,12,0,6"/>
                <TextBox Text="{Binding Relationship, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Telefon" Margin="0,12,0,6"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="E-posta" Margin="0,12,0,6"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Adres" Margin="0,12,0,6"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="56" TextWrapping="Wrap"/>
                <TextBlock Text="Notlar" Margin="0,12,0,6"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="72" TextWrapping="Wrap" AcceptsReturn="True"/>
                <CheckBox Content="Doğum günü" IsChecked="{Binding HasBirthday}" Margin="0,14,0,6"/>
                <DatePicker SelectedDate="{Binding Birthday}" Visibility="{Binding HasBirthday, Converter={StaticResource BoolToVis}}"/>
                <CheckBox Content="Yıldönümü / önemli tarih" IsChecked="{Binding HasAnniversary}" Margin="0,12,0,6"/>
                <DatePicker SelectedDate="{Binding Anniversary}" Visibility="{Binding HasAnniversary, Converter={StaticResource BoolToVis}}"/>
                <CheckBox Content="Son görüşme" IsChecked="{Binding HasLastContact}" Margin="0,12,0,6"/>
                <DatePicker SelectedDate="{Binding LastContact}" Visibility="{Binding HasLastContact, Converter={StaticResource BoolToVis}}"/>
                <CheckBox Content="Bu hafta ara / takip" IsChecked="{Binding FollowUpThisWeek}" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToVisInv}}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
