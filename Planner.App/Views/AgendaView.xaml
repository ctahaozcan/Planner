<UserControl x:Class="Planner.App.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Planner.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ Yeni kayıt" Command="{Binding NewTaskCommand}"/>
                <TextBlock Text="Önümüzdeki iki hafta" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,3" Background="{DynamicResource AccentSoftBrush}"
                                            Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Bugün" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                    <TextBlock>
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </TextBlock>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Leaves}" Margin="0,10,0,0"
                                              Visibility="{Binding HasLeaves, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" CornerRadius="8" Padding="10,8"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                    BorderThickness="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}"
                                           Text="Bu gün için kayıt yok."
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <views:TaskCard/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
