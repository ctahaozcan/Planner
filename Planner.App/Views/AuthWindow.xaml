<Window x:Class="Planner.App.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yaver"
        Height="760" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Yaver" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,16" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="Özel kullanım için şirket seçmeyin. İş için yönetim panelinden davet kodu alın; boş kadroyu herkes seçemez."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource ChipButton}" Content="Kayıt" Command="{Binding ShowRegisterCommand}"/>
                <Button Style="{StaticResource ChipButton}" Content="Giriş" Command="{Binding ShowLoginCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ModeLabel}" FontSize="18" FontWeight="SemiBold"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
            <StackPanel>
                <StackPanel Visibility="{Binding IsRegister, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Hesap türü" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Özel" Command="{Binding UsePersonalCommand}" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageIsPersonal}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="İş" Command="{Binding UseWorkCommand}" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageIsWork}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="İkisi birlikte" Command="{Binding UseBothCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageIsBoth}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Ad" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Soyad" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="E-posta" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Visibility="{Binding NeedsCompany, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Sunucu" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Davet kodu" Margin="0,12,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Kadroya bak"
                                    Command="{Binding LookupInviteCommand}" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding InviteSummary}"
                                   Visibility="{Binding HasInvitePreview, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="{Binding CompanyHint}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Kullanıcı adı" Margin="0,12,0,6"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Şifre" Margin="0,12,0,6"/>
                <PasswordBox x:Name="PasswordBox" Height="40" KeyDown="OnPasswordKeyDown"/>
                <CheckBox Margin="0,14,0,0" Content="Beni hatırla" IsChecked="{Binding RememberMe}"/>
                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           Text="{Binding Error}"/>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="{Binding Status}"/>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="{Binding ModeLabel}"
                Click="OnSubmit" HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
