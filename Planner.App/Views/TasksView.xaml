<UserControl x:Class="Planner.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Planner.App.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategory}" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilters}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedStatus}" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="+ Yeni" Command="{Binding NewTaskCommand}"/>
        </Grid>
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="{Binding ResultText}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInv}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:TaskCard/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Eşleşen kayıt yok." FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Süzgeçleri temizleyin veya yeni bir görev / ajanda kaydı ekleyin."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
