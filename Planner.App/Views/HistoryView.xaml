<UserControl x:Class="Planner.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding Ranges}"
                      DisplayMemberPath="Name" SelectedItem="{Binding SelectedRange}"/>
            <TextBlock Text="{Binding ResultText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"
                        Visibility="{Binding HasMonthlyStats, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Aylık özet" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Margin="0,6,0,10" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Oluşturulan ve bitirilen görev sayıları. Ortalama bitirme süresi, görevin Devam Ediyor durumunda geçirdiği toplam süredir."/>
                        <DataGrid ItemsSource="{Binding MonthlyStats}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  EnableRowVirtualization="True"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource TextBrush}"
                                  BorderThickness="0"
                                  RowBackground="{DynamicResource SurfaceBrush}"
                                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                  MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ay" Binding="{Binding MonthLabel}" Width="*"/>
                                <DataGridTextColumn Header="Oluşturulan" Binding="{Binding CreatedCount}" Width="110"/>
                                <DataGridTextColumn Header="Bitirilen" Binding="{Binding CompletedCount}" Width="100"/>
                                <DataGridTextColumn Header="Ort. bitirme süresi" Binding="{Binding AverageText}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInv}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14" Cursor="Hand"
                                    MouseLeftButtonUp="OnItemActivate">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="8" Padding="10,4"
                                            Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DurationText}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding CompletedText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Geçmiş boş." FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Tamamlanan görevler burada, Devam Ediyor olarak geçirilen süreleriyle listelenir. Aralığı değiştirerek daha eskiye bakabilirsiniz."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
