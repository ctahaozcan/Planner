<Window x:Class="Planner.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sohbet"
        Height="680" Width="980"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource AppBgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
                    <TextBlock Text="Sohbet" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}">
                        <Run Text="Oturum:"/>
                        <Run Text="{Binding MeName, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="{Binding ConnectionHint}"/>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12"
                               Visibility="{Binding HasPeople, Converter={StaticResource BoolToVisInv}}"
                               Text="Kişiler yerel hesap, aynı ağ veya sunucudan gelir. Önce arkadaş ekleyin; arkadaş olmayana mesaj gitmez."/>
                </StackPanel>
                <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPeer}"
                         BorderThickness="0" Background="Transparent" Margin="8,0,8,12"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasPeople, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="#22C55E"
                                             Visibility="{Binding IsOnline, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Style="{StaticResource ChipButton}" Content="Arkadaş ekle" Margin="0,0,6,4"
                            Command="{Binding AddFriendCommand}" IsEnabled="{Binding HasPeer}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Ajanda izni" Margin="0,0,6,4"
                            Command="{Binding AllowAgendaCommand}" IsEnabled="{Binding IsFriend}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Ajanda" Margin="0,0,6,4"
                            Command="{Binding ViewAgendaCommand}" IsEnabled="{Binding IsFriend}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Görev ata" Margin="0,0,6,4"
                            Command="{Binding AssignTaskCommand}" IsEnabled="{Binding IsFriend}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Ara" Margin="0,0,6,4"
                            Command="{Binding CallAudioCommand}" IsEnabled="{Binding IsFriend}"/>
                    <Button Style="{StaticResource ChipButton}" Content="Görüntülü" Margin="0,0,6,4"
                            Command="{Binding CallVideoCommand}" IsEnabled="{Binding IsFriend}"/>
                </WrapPanel>
                <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEmptyThread, Converter={StaticResource BoolToVisInv}}">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                        <Border MaxWidth="440" Padding="10,8" CornerRadius="12"
                                                HorizontalAlignment="{Binding Align}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock FontSize="11" Style="{StaticResource MutedText}">
                                                    <Run Text="{Binding FromName, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding TimeText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Image Source="{Binding Picture}" MaxWidth="280" Margin="0,6,0,0"
                                                       Stretch="Uniform"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisInv}}"/>
                                                <Button Style="{StaticResource PrimaryButton}" Content="Kabul et" Margin="0,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding ShowAccept, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.AcceptFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                               Visibility="{Binding IsEmptyThread, Converter={StaticResource BoolToVis}}"
                               Text="Soldan bir kişi seçin. Arkadaş değilseniz önce «Arkadaş ekle» deyin."/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Gönder"
                        Command="{Binding SendCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanMessage}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Resim"
                        Command="{Binding SendImageCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding CanMessage}"/>
                <Border CornerRadius="10" Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <TextBox Height="44" FontSize="15" Background="Transparent" BorderThickness="0"
                             IsEnabled="{Binding CanMessage}"
                             Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
