<Window x:Class="Planner.App.Views.LeaveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="640" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}">
    <Grid Margin="36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostIconButton}" Content="←" FontSize="18"
                    Width="36" Height="36" Margin="0,0,12,0"
                    Command="{Binding GoBackCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"/>
            <StackPanel>
                <TextBlock Text="{Binding StepTitle}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StepSubtitle}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           FontSize="14"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel Visibility="{Binding IsKindStep, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding KindCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,12,12" Padding="18,20"
                                        Command="{Binding DataContext.SelectKindCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ChoiceCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding KindHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Margin="4,4,0,0"/>
                    <StackPanel Margin="4,16,0,0"
                                Visibility="{Binding ShowOtherTypes, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="İzin türü" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Types}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedType}" MaxWidth="320" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>

                <Grid Visibility="{Binding IsTimeStep, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Başlangıç Tarihi" FontWeight="SemiBold" FontSize="15"/>
                            <DatePicker SelectedDate="{Binding StartDate}" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding StartHour}" Width="88" Margin="0,0,8,0"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding StartMinute}" Width="88"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Bitiş Tarihi" FontWeight="SemiBold" FontSize="15"/>
                            <DatePicker SelectedDate="{Binding EndDate}" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding EndHour}" Width="88" Margin="0,0,8,0"/>
                                <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding EndMinute}" Width="88"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVis}}" MaxWidth="520"
                            HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Özet" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding SummaryKindText}"/>
                            <TextBlock Margin="0,8,0,0" Text="{Binding SummaryWhenText}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,12,0,0" Text="{Binding PreviewText}" TextWrapping="Wrap"
                                       Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Durum" Margin="0,18,0,8"/>
                    <ComboBox ItemsSource="{Binding Statuses}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedStatus}" Width="220" HorizontalAlignment="Left"
                              IsEnabled="{Binding StatusUnlocked}"/>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="{Binding ApprovalHint}"/>
                    <TextBlock Text="Not (isteğe bağlı)" Margin="0,16,0,8"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="72"
                             TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    Content="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}"
                    MinWidth="140"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Vazgeç"
                    Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToVisInv}}"/>
        </DockPanel>
    </Grid>
</Window>
