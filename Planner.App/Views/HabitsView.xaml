<UserControl x:Class="Planner.App.Views.HabitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Yeni alışkanlık" FontWeight="SemiBold" FontSize="16"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
                    <CheckBox Content="Yalnızca hafta içi" IsChecked="{Binding WeekdaysOnly}" Margin="0,10,0,0"/>
                    <CheckBox Content="Anımsatıcı" IsChecked="{Binding HasReminder}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding HasReminder, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding ReminderHour}" Width="80" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding ReminderMinute}" Width="80"/>
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="Ekle" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Command="{Binding AddCommand}"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Sil"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}" Command="{Binding ToggleCommand}"
                                          Content="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StreakText}" Style="{StaticResource MutedText}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="4,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
