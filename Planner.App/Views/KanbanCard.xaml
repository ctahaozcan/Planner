<UserControl x:Class="Planner.App.Views.KanbanCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             ToolTip="Tek tık: ayrıntı ve ekler · Çift tık: düzenle">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="0"
            Margin="0,0,0,8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="1" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="4" CornerRadius="10,0,0,10"
                    Background="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"/>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="4,8,8,8">
                <Button Style="{StaticResource GhostIconButton}" Content="✎" ToolTip="Düzenle"
                        Command="{Binding EditCommand}"/>
            </StackPanel>
            <StackPanel Margin="10,8,4,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShortId}" FontSize="11"
                               Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="{Binding TimeText}" FontSize="11" FontWeight="SemiBold"
                               Style="{StaticResource MutedText}" Margin="0,0,8,0"
                               Visibility="{Binding TimeText, Converter={StaticResource EmptyToVisInv}}"/>
                    <Border CornerRadius="8" Padding="6,1" Margin="0,0,6,0" Background="{DynamicResource ChipBgBrush}">
                        <TextBlock FontSize="11" Text="{Binding CategoryName}"
                                   Foreground="{Binding CategoryColor, Converter={StaticResource HexToBrush}}"/>
                    </Border>
                    <Border CornerRadius="8" Padding="6,1" Margin="0,0,6,0" Background="{DynamicResource PriorityBandBrush}"
                            Visibility="{Binding IsPriority, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11" Text="★ Öncelik" FontWeight="SemiBold"/>
                    </Border>
                    <Button Style="{StaticResource ChipButton}" Content="★" Padding="6,1" Margin="0"
                            ToolTip="Öncelik (en fazla 3)"
                            Command="{Binding PinCommand}"
                            Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
