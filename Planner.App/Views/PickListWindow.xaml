<Window x:Class="Planner.App.Views.PickListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seç"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}">
    <DockPanel Margin="16">
        <TextBlock x:Name="HintBlock" DockPanel.Dock="Top" Style="{StaticResource MutedText}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Vazgeç" IsCancel="True" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Seç" IsDefault="True" Click="OnOk"/>
        </StackPanel>
        <ListBox x:Name="ItemList" BorderThickness="0" Background="{DynamicResource SurfaceAltBrush}"
                 MouseDoubleClick="OnOk"/>
    </DockPanel>
</Window>
