<UserControl x:Class="Planner.App.Views.OrgWorkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,8,12,8">
                    <TextBlock FontWeight="SemiBold" Text="Doğrudan altınız"/>
                    <TextBlock Margin="0,4,0,8" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Görev yalnızca bir kademe aşağı verilir."/>
                </StackPanel>
                <ListBox ItemsSource="{Binding DirectReports}" SelectedItem="{Binding SelectedReport}"
                         BorderThickness="0" Background="Transparent" Margin="8,0,8,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                    <Run Text="{Binding PositionTitle, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding UnitName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" Margin="18,8,8,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Ekip görevleri"/>
                <TextBlock Margin="0,4,0,12" Style="{StaticResource MutedText}" Text="{Binding RoleLabel}"/>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding Hint}"/>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"
                        Visibility="{Binding CanAssign, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Görev ata"/>
                        <TextBlock Text="Başlık" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Tarih (yyyy-AA-gg)" Margin="0,12,0,6"/>
                        <TextBox Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Not" Margin="0,12,0,6"/>
                        <TextBox MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Margin="0,12,0,0" Style="{StaticResource PrimaryButton}" Content="Ata"
                                Command="{Binding AssignCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Size atananlar"/>
                        <ListBox ItemsSource="{Binding Inbox}" SelectedItem="{Binding SelectedInbox}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                            <Run Text="{Binding AssignedByName, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Date, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,8,0,6" Text="Bir altınıza dağıt"/>
                        <ComboBox ItemsSource="{Binding DirectReports}" SelectedItem="{Binding DistributeTo}"
                                  DisplayMemberPath="DisplayName"/>
                        <Button Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" Content="Dağıt"
                                Command="{Binding DistributeCommand}" HorizontalAlignment="Left"
                                IsEnabled="{Binding CanAssign}"/>
                        <TextBlock Margin="0,16,0,6" FontWeight="SemiBold" Text="Kurum dosyası (sunucu, 20 MB)"/>
                        <ItemsControl ItemsSource="{Binding TaskFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Content="Aç"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SizeBytes, Mode=OneWay}"/>
                                            <Run Text=" bayt"/>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Content="Dosya ekle"
                                Command="{Binding AttachFileCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"
                        Visibility="{Binding CanManageLeaves, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="İzin durumu"/>
                        <TextBlock Margin="0,0,0,10" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Talep bir üst amire düşer. İzin yetkilisi (yönetim panelinde işaretli kadro) şirket genelinde onaylar."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="Kişi"/>
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Kadro"/>
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Bugün"/>
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Sıradaki"/>
                            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Talep"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding LeavePeople}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="{Binding Role}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TodayStatus}"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource MutedText}" Text="{Binding NextLeave}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PendingText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16"
                        Visibility="{Binding HasLeaveInbox, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Onay bekleyen izinler"/>
                        <ListBox ItemsSource="{Binding LeaveInbox}" SelectedItem="{Binding SelectedLeave}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Who, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Type, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                            <Run Text="{Binding When, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Onayla"
                                    Command="{Binding ApproveLeaveCommand}"/>
                            <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Reddet"
                                    Command="{Binding RejectLeaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Altınızdakilerin işleri"/>
                        <ItemsControl ItemsSource="{Binding TeamTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                            <Run Text="{Binding AssignedToName, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Date, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding AssignedByName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="Denetim günlüğü"/>
                        <TextBlock Margin="0,0,0,10" Style="{StaticResource MutedText}" Text="Kim kime ne görev verdi."/>
                        <ItemsControl ItemsSource="{Binding AuditEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock>
                                            <Run Text="{Binding Actor, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Action, Mode=OneWay}"/>
                                            <Run Text=" → "/>
                                            <Run Text="{Binding Target, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                            <Run Text="{Binding When, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Detail, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
