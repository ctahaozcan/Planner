<Window x:Class="Planner.App.Views.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arama · Yaver"
        Height="640" Width="920"
        MinHeight="480" MinWidth="720"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="#111827">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#0B1220">
            <Grid>
                <TextBlock x:Name="Placeholder" Text="Karşı tarafın görüntüsü veya ekranı burada."
                           Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="32"/>
                <Image x:Name="RemoteImage" Stretch="Uniform" Margin="12"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#1F2937" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MicButton" Style="{StaticResource SecondaryButton}" Content="Mikrofon"
                            Click="OnMic" Margin="0,0,8,0"/>
                    <Button x:Name="CamButton" Style="{StaticResource SecondaryButton}" Content="Kamera"
                            Click="OnCamera" Margin="0,0,8,0"/>
                    <Button x:Name="ShareButton" Style="{StaticResource SecondaryButton}" Content="Ekran paylaş"
                            Click="OnShare" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DangerButton}" Content="Kapat" Click="OnHangUp"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PeerLabel" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusLabel" Foreground="#93C5FD" Margin="0,4,0,0" Text="Bağlanıyor…"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
