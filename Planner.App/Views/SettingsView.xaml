<UserControl x:Class="Planner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Görünüm" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,10" Style="{StaticResource MutedText}" Text="Açık, koyu veya Windows temasını izle."/>
                    <ComboBox ItemsSource="{Binding ThemeLabels}" SelectedItem="{Binding SelectedThemeLabel}" Width="220" HorizontalAlignment="Left"/>
                    <CheckBox Margin="0,16,0,0" Content="Windows oturum açıldığında başlat (tepsi, anımsatıcılar açık)"
                              IsChecked="{Binding StartWithWindows}"/>
                    <CheckBox Margin="0,10,0,0" Content="Başlangıçta pencereyi gizle (yalnızca tepsi)"
                              IsChecked="{Binding StartMinimized}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Sabah özeti ve akşam kapanışı" FontWeight="SemiBold" FontSize="16"/>
                    <CheckBox Margin="0,10,0,0" Content="Sabah özeti" IsChecked="{Binding MorningBriefingEnabled}"/>
                    <TextBlock Margin="0,8,0,4" Style="{StaticResource MutedText}" Text="Saat"/>
                    <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding MorningBriefingTime}" Width="120" HorizontalAlignment="Left"/>
                    <CheckBox Margin="0,14,0,0" Content="Akşam kapanışı" IsChecked="{Binding EveningCloseEnabled}"/>
                    <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding EveningCloseTime}" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Sessiz saatler" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,8" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Bu aralıkta toast gösterilmez; kuyruğa alınır ve bitince iletilir."/>
                    <CheckBox Content="Sessiz saatleri aç" IsChecked="{Binding QuietHoursEnabled}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding QuietHoursStart}" Width="120" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding QuietHoursEnd}" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Gün görünümü saatleri" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,8" Style="{StaticResource MutedText}" Text="Şerit aralığı ve vurgulanan çalışma bandı."/>
                    <TextBlock Text="Şerit" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                        <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding DayViewStart}" Width="120" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding DayViewEnd}" Width="120"/>
                    </StackPanel>
                    <TextBlock Text="Çalışma bandı" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding WorkBandStart}" Width="120" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding WorkBandEnd}" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Genel kısayol" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,8" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Pencere tepsideyken bile hızlı eklemeyi açar. Varsayılan: Ctrl+Alt+N."/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding HotkeyKeys}" SelectedItem="{Binding HotkeyKey}" Width="80"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Text="{Binding HotkeyPreview}" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding HotkeyStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Odak (Pomodoro)" FontWeight="SemiBold" FontSize="16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Odak (dk)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding PomodoroFocus, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,16,0"/>
                        <TextBlock Text="Mola (dk)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding PomodoroBreak, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Kategoriler" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,10" Style="{StaticResource MutedText}"
                               Text="İş, Kişisel ve Özel varsayılandır. Kendi etiketlerinizi ekleyebilirsiniz."/>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                             Height="160" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="  (varsayılan)" Style="{StaticResource MutedText}"
                                               Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding NewCategoryColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Ekle" Command="{Binding AddCategoryCommand}"/>
                    </Grid>
                    <Button Style="{StaticResource DangerButton}" Content="Seçili kategoriyi sil" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding DeleteCategoryCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Yedekleme" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,10" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Şifreyi unutursanız kişiler ve şifreli yedekler kurtarılamaz. JSON dışa aktarma kişi bilgisi içermez."/>
                    <WrapPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="Kasa yedeği al" Command="{Binding ExportVaultCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Kasa geri yükle" Command="{Binding ImportVaultCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Veritabanı yedeği" Command="{Binding ExportDatabaseCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Veritabanını geri yükle" Command="{Binding RestoreDatabaseCommand}" Margin="0,0,8,8"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Görevleri JSON dışa aktar" Command="{Binding ExportJsonCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Veri klasörü" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,8" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Veritabanı OneDrive masaüstünde değil, yerel uygulama verilerinde tutulur."/>
                    <TextBox Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Klasörü aç" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Command="{Binding OpenDataFolderCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Kişiler kasası" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Margin="0,6,0,8" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                               Text="Şifre unutulursa kişiler kurtarılamaz. Sıfırlamak tüm şifreli kişileri siler."/>
                    <Button Style="{StaticResource DangerButton}" Content="Kasayı sıfırla" HorizontalAlignment="Left"
                            Command="{Binding ResetVaultCommand}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="4,0,0,16"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="Yaver 1.1 — yerel günlük asistan. Anımsatıcılar tepside bekler; saniyede tarama yapmaz."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
